# Copy to .env for Docker Compose. Replace all blank secrets before starting.
# Generate opaque secrets locally with: python -c "import secrets; print(secrets.token_hex(32))"
DEMO_MODE=true
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Required by docker-compose.yml; use independent random values.
POSTGRES_PASSWORD=
API_TOKEN=
JWT_SECRET=
ADMIN_BOOTSTRAP_KEY=
JWT_EXPIRE_MINUTES=30

# Local Docker-published ports and browser origin allow-list.
API_PORT=8000
FRONTEND_PORT=8501
API_BIND=127.0.0.1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Local direct-run defaults (Compose overrides the database and service URLs).
DATABASE_URL=sqlite:///./opspilot.db
OPERLYNT_API=http://127.0.0.1:8000
UPLOAD_DIR=./data/uploads
VECTOR_DIR=./data/vector_store
WORKFLOW_CHECKPOINT_PATH=./data/workflows/checkpoints.sqlite
MCP_TIMEOUT_SECONDS=180
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.18
